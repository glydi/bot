# GLYDI configuration for a Jetson Orin Nano 8 GB (JetPack 6.x, Ubuntu
# 22.04, aarch64). Copy to the repo root as .env; install.sh does that on
# a first run. Derived from .env.example: same keys, Jetson values.
#
# The binary reads the environment only. glydi.service loads this file
# through EnvironmentFile=, so: KEY=value lines, no `export`, no shell
# expansion ($HOME, ~ and `$(...)` stay literal), no quotes needed.
# Precedence: environment > ~/.config/glydi/config.toml > defaults.
# Relative paths resolve against the repository root (GLYDI_ROOT, else
# the checkout the binary was built from).

# --- language model (Ollama, OpenAI-compatible) ---------------------------
# glydi-1.5b is the fine-tuned Qwen2.5-1.5B (train/), built by install.sh
# from models/glydi-1.5b.q4_K_M.gguf with num_ctx 2048 (deploy/jetson/
# Modelfile); if the GGUF is not on the board yet it is the untuned
# qwen2.5:1.5b under the same name, rebuilt on the next install.sh run.
# ~1.4 GB resident with its q8_0 KV cache (docs/jetson-memory-map.md).
# qwen2.5:3b calls tools more reliably untuned but takes ~2.2 GB; it is
# pulled too, swap only headless and watch `free -m`.
# The mind. With a key, Claude answers (streamed, prompt-cached, effort
# low) and the local model below is only the offline fallback; without a
# key the local model answers everything. Faces and the gallery never
# leave the board.
#ANTHROPIC_API_KEY=sk-ant-...
#GLYDI_CLOUD_MODEL=claude-opus-5-5
#GLYDI_CLOUD_EFFORT=low
GLYDI_LOCAL_MODEL=glydi-1.5b
#GLYDI_LOCAL_MODEL=qwen2.5:1.5b
#GLYDI_LOCAL_MODEL=qwen2.5:3b
# Ollama on the same box. ollama.service listens here by default; its
# flags (keep-alive, flash attention, q8_0 KV cache, one model, one
# slot) are in deploy/jetson/ollama-override.conf, installed by install.sh.
GLYDI_LOCAL_LLM_URL=http://localhost:11434/v1
# A separate model for fact extraction (default: the same model). Leave
# unset: a second resident model does not fit in 8 GB.
#GLYDI_MEMORY_MODEL=qwen2.5:1.5b
# Shorter replies are faster on the Orin and better for a foyer anyway.
#GLYDI_MAX_TOKENS=300

# --- speech ---------------------------------------------------------------
# Transcriber: parakeet (NVIDIA Parakeet TDT 0.6B v2, int8 ONNX, ~2x faster
# than whisper with the same words) or whisper (whisper.cpp tiny.en on the
# CPU; there is no Metal here, so it is the slow choice on this board).
# Parakeet's files come from scripts/fetch-models.sh into models/parakeet/;
# if they are missing glydi logs a warning and falls back to whisper.
GLYDI_STT=parakeet
# Whisper is still loaded as the fallback; tiny.en is the cheapest.
GLYDI_WHISPER_MODEL=tiny.en
# Spoken language: "en", "hi", ... or "auto" (multilingual whisper only).
#GLYDI_LANGUAGE=en
# Voice: kokoro (in-process ONNX, --features kokoro, the only option on
# Linux; `mac` is the macOS system voice and does not exist here).
GLYDI_TTS=kokoro
# Kokoro, Parakeet's encoder and the vision models on the GPU: needs the
# CUDA/TensorRT build of onnxruntime (install.sh, TODO(jetson-gpu));
# harmless with the CPU one (the provider fails to register, logged, and
# the CPU runs the graph).
GLYDI_TTS_GPU=1
GLYDI_STT_GPU=1
GLYDI_VISION_GPU=1
# TensorRT (FP16) in front of CUDA for every GPU model. The first start
# builds an engine per model and shape under models/.../trt_cache (several
# minutes on the Orin Nano, once); later starts load them from disk.
GLYDI_TRT=1
# Refuse to start with less than this much memory free (MB), so the board
# never swaps mid-utterance. 0 turns the gate off.
GLYDI_MIN_FREE_MB=1536
GLYDI_FULLSCREEN=1
#GLYDI_KOKORO_VOICE=af_bella
# Microphone: a substring of the ALSA/cpal device name. Leave empty for
# the default input. `arecord -l` lists cards; the cpal name is usually
# the card name, e.g. "ReSpeaker" for a ReSpeaker USB array, "USB Audio"
# for a generic dongle, "Jabra" for a speakerphone.
GLYDI_MIC_DEVICE=
# Acoustic echo cancellation while the bot speaks (1) so people can talk
# over it; 0 mutes the mic during playback. A speakerphone with its own
# AEC (Jabra, ReSpeaker) can run with 0 and save the CPU.
GLYDI_AEC=1
# Output latency (ms) between the ring and the mouth moving. USB/3.5 mm
# speakers ~40; raise for Bluetooth.
#GLYDI_LIP_SYNC_MS=40

# --- identity -------------------------------------------------------------
# 0 disables face and voice recognition (voice-only chat).
GLYDI_IDENTITY=1
GLYDI_FACE_MODEL=buffalo_s
# Where fetch-models.sh unpacked buffalo_s (default ~/.insightface/models/buffalo_s;
# "~" is expanded by glydi itself, so this is safe under systemd).
#GLYDI_INSIGHTFACE_DIR=~/.insightface/models/buffalo_s
# Speaker recognition; skipped if the file is absent (it is exported, not
# downloaded: fetch-models.sh prints the two commands).
GLYDI_VOICE_MODEL=models/voiceid/ecapa.onnx
# V4L2 device index: 0 = /dev/video0, the first USB (UVC) camera.
# `v4l2-ctl --list-devices` shows which index is which; a CSI camera on
# the ribbon connector is not supported yet (see kiosk.md).
GLYDI_CAMERA_INDEX=0
# Open-set gates: cosine threshold and margin over the runner-up.
#GLYDI_FACE_THRESHOLD=0.36
#GLYDI_FACE_MARGIN=0.06
#GLYDI_VOICE_THRESHOLD=0.55
#GLYDI_VOICE_MARGIN=0.08

# --- reach ----------------------------------------------------------------
# Both off on a kiosk: run_shortcut is a macOS Shortcuts tool and has
# nothing to run here; open_facetime / send_message would let a misheard
# name call a stranger from a school foyer.
GLYDI_ALLOW_SHORTCUTS=0
GLYDI_ALLOW_CONTACT_TOOLS=0
# Local UTC offset for reminder times ("+05:30"); default `date +%z`.
#GLYDI_UTC_OFFSET=+05:30

# --- storage and runtimes -------------------------------------------------
# The gallery and memory. Relative to the repo root; data/ is gitignored.
GLYDI_DB=data/glydi.db
# ONNX and ggml files (fetch-models.sh). Also models/vision/yolov5n.onnx.
GLYDI_MODELS_DIR=models
# ONNX Runtime shared library: the aarch64 CPU build install.sh unpacks
# from the microsoft/onnxruntime release. Relative, resolved against the
# repo root. GPU/TensorRT EP: the CUDA build, see the TODO in install.sh.
ORT_DYLIB_PATH=models/onnxruntime/linux-aarch64/libonnxruntime.so
# espeak-ng for Kokoro's phonemiser. The loader's built-in search looks
# for a Homebrew-style libespeak-ng.dylib, which does not exist on Linux,
# so the Ubuntu library and its data must be named explicitly (both are
# from the libespeak-ng1 / espeak-ng-data packages; the paths are the
# aarch64 multiarch ones).
PHONEMIZER_ESPEAK_LIBRARY=/usr/lib/aarch64-linux-gnu/libespeak-ng.so.1
ESPEAK_DATA_PATH=/usr/lib/aarch64-linux-gnu/espeak-ng-data
# Log level for the journal: info is the normal chatter, debug is a lot.
RUST_LOG=info
# Only needed if the binary is moved away from the checkout it was built
# in (install-service.sh also sets it on the unit).
#GLYDI_ROOT=/home/glydi/bot
# Silence before a turn is judged over. 256 ms measured best: 300 ms from the
# last word to the transcript; 480 (the old default) was 500, 160 gains nothing.
GLYDI_HANGOVER_MS=256
