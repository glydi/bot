# GLYDI configuration. Copy to .env or export in your shell.
# Precedence: environment > .env > ~/.config/glydi/config.toml > defaults.
# The binary reads <repo root>/.env itself at start-up (KEY=value lines,
# `export KEY=value` tolerated, one layer of quotes stripped, no $VAR
# expansion); a variable already set in the shell is never replaced.
# Relative paths resolve against the repository root.

# --- language model (Ollama, OpenAI-compatible) ---------------------------
# 3b answers in ~1 s on an M-series laptop; 7b is noticeably better at
# calling memory tools but roughly doubles the wait. On a Jetson Orin Nano
# (8 GB shared between the GPU and everything else) use qwen2.5:1.5b: it
# leaves room for the speech models, and 3b starts swapping.
GLYDI_LOCAL_MODEL=qwen2.5:3b
#GLYDI_LOCAL_MODEL=qwen2.5:1.5b
GLYDI_LOCAL_LLM_URL=http://localhost:11434/v1
# A smaller model for fact extraction, if you want one (default: same model).
#GLYDI_MEMORY_MODEL=qwen2.5:3b
#GLYDI_MAX_TOKENS=300

# --- speech ---------------------------------------------------------------
# Name (-> models/whisper/ggml-<name>.bin) or a path.
GLYDI_WHISPER_MODEL=tiny.en
# Transcriber: whisper (default) or parakeet (NVIDIA Parakeet TDT 0.6B v2,
# ~2x faster with the same words; files under models/parakeet/, see
# rust/sense-audio/src/parakeet.rs for the download). On Linux, and the
# Jetson in particular, set parakeet: whisper.cpp's GPU path is Metal-only,
# so there it runs on the CPU, while Parakeet rides onnxruntime like the
# other models.
#GLYDI_STT=parakeet
# Spoken language: "en", "hi", ... or "auto" (needs a multilingual model,
# e.g. GLYDI_WHISPER_MODEL=base; a ".en" model is always English).
#GLYDI_LANGUAGE=auto
# mac (AVSpeech via rust/ttsd, always available) or kokoro (--features kokoro).
GLYDI_TTS=mac
#GLYDI_MAC_VOICE=com.apple.voice.compact.en-US.Samantha
#GLYDI_KOKORO_VOICE=af_bella
# A case-insensitive substring of the input device's name ("ReSpeaker"
# finds "ReSpeaker 4 Mic Array (UAC1.0): USB Audio (hw:2,0)").
#GLYDI_MIC_DEVICE=MacBook Air Microphone
# Acoustic echo cancellation while the bot speaks, so you can talk over it
# and be heard. 0 mutes the mic during playback instead (the old behaviour).
#GLYDI_AEC=1
# Delay (ms) between the speaker's audio leaving the ring and the mouth
# moving: the output device's latency. Raise for Bluetooth headphones.
#GLYDI_LIP_SYNC_MS=40

# --- identity -------------------------------------------------------------
# 0 disables face and voice recognition (voice-only chat).
GLYDI_IDENTITY=1
GLYDI_FACE_MODEL=buffalo_s
#GLYDI_INSIGHTFACE_DIR=~/.insightface/models/buffalo_s
GLYDI_VOICE_MODEL=models/voiceid/ecapa.onnx
#GLYDI_CAMERA_INDEX=0
# Open-set gates: cosine threshold and margin over the runner-up.
#GLYDI_FACE_THRESHOLD=0.36
#GLYDI_FACE_MARGIN=0.06
#GLYDI_VOICE_THRESHOLD=0.55
#GLYDI_VOICE_MARGIN=0.08

# --- reach (macOS) --------------------------------------------------------
# run_shortcut: the model may run one of your Shortcuts by name. On by
# default; 0 removes the tool entirely.
#GLYDI_ALLOW_SHORTCUTS=1
# open_facetime / send_message reach another person, and a misheard name
# calls the wrong one: off unless you say so.
#GLYDI_ALLOW_CONTACT_TOOLS=0
# Local UTC offset for reminder times ("+05:30", "-0700"); default `date +%z`.
#GLYDI_UTC_OFFSET=+05:30

# --- storage and runtimes -------------------------------------------------
GLYDI_DB=data/glydi.db
# Also holds models/vision/yolov8n.onnx (or yolov5n.onnx) for object detection.
GLYDI_MODELS_DIR=models
# The ONNX Runtime shared library. Unset, each platform's default is used:
# macOS the Homebrew dylib below; Windows models/onnxruntime/onnxruntime.dll;
# Linux the first of models/onnxruntime/linux-<x86_64|aarch64>/libonnxruntime.so
# (the unpacked Microsoft tarball; linux-x64 is accepted for the former),
# /usr/local/lib/libonnxruntime.so, /usr/lib/libonnxruntime.so.
#ORT_DYLIB_PATH=/opt/homebrew/lib/libonnxruntime.dylib
# espeak-ng for Kokoro is found the same way (Homebrew, the MSI directory,
# or on Linux /usr/lib/<arch>-linux-gnu/libespeak-ng.so.1 from apt's
# libespeak-ng1); name it here only when it lives somewhere else.
#PHONEMIZER_ESPEAK_LIBRARY=/usr/lib/aarch64-linux-gnu/libespeak-ng.so.1

# The window is the status panel with a settings screen (for a 10-inch
# display); GLYDI_FULLSCREEN=1 fills the display, `--fullscreen` for one
# run. The animated face is archived: `glydi run --face` still shows it.
#GLYDI_FULLSCREEN=0

# Kokoro on an NVIDIA GPU. The CPU gets a reply's first words out in
# 440-1070 ms; CUDA does the same chunk in 130-320 ms (RTX 5060). Point
# ORT_DYLIB_PATH at a CUDA build of onnxruntime whose directory also holds
# onnxruntime_providers_cuda.dll and the CUDA 13 / cuDNN 9 libraries
# (BUILD.md, "The voice on the GPU"); the senses keep using the CPU
# provider of the same library. DirectML cannot run this model.
#GLYDI_TTS_GPU=1

# The cloud mind. With a key, Claude answers the conversation (streamed,
# prompt-cached, effort low for a fast first word) and `GLYDI_LOCAL_MODEL`
# is only the fallback when the network is down. Faces, the gallery and
# the voice never leave the machine; the model sees text and calls the
# memory tools. Fact extraction uses claude-haiku-4-5 unless
# GLYDI_MEMORY_MODEL names a Claude model.
#ANTHROPIC_API_KEY=sk-ant-...
#GLYDI_CLOUD_MODEL=claude-opus-5-5
#GLYDI_CLOUD_EFFORT=low

# Parakeet's encoder on the GPU, with the same CUDA runtime as the voice.
#GLYDI_STT_GPU=1
# The face detector, recogniser and object model on the GPU too.
#GLYDI_VISION_GPU=1
# TensorRT (FP16, engines cached under models/.../trt_cache) in front of
# CUDA for every GPU model above. For the Jetson; the first start builds
# the engines and is slow, once.
#GLYDI_TRT=1
# Refuse to start with less than this many MB free (default 1536; 0 off).
#GLYDI_MIN_FREE_MB=1536

# How long a pause must last before the turn is judged over, in ms (32 ms
# frames; default 480). The smart-turn judge holds a turn open when the
# sentence is plainly unfinished, which is what makes a short hangover
# safe. Measured with Parakeet on CUDA (rust/sense-audio/tests/latency.rs),
# last word -> transcript: 480 ms gives 500 ms, 256 gives 305, 160 gives 325
# (the transcript cannot be ready that fast, so nothing is gained).
#GLYDI_HANGOVER_MS=256

# The school ERP. With all three set the bot signs in as its own user,
# keeps the days ahead (timetable, holidays, exams, absentees) in
# data/school.json and answers questions about any day from that copy,
# and marks a greeted, recognised person present once a day.
# scripts/erp-robot-account.py creates the account with the permissions
# it needs. GLYDI_UTC_OFFSET decides what "today" is.
#GLYDI_ERP_URL=https://erp.xulo.in
#GLYDI_ERP_USER=glydi@robot.local
#GLYDI_ERP_PASSWORD=
