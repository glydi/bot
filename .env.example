# Nothing here is required. The default configuration runs entirely on this
# machine: local speech, a local language model, local recognition, a local
# gallery. No key, no account, nothing leaves the room.

# --- speech stack ---
# "local" (default): MLX Whisper + Kokoro, no keys, no cost, nothing leaves the
#   machine. Slower: ~850ms-1.2s turns.
# "hosted": Deepgram + Cartesia. ~550-650ms turns, a few cents/min, needs the
#   two keys below.
GLYDI_SPEECH=local

GLYDI_WHISPER_MODEL=LARGE_V3_TURBO_Q4
GLYDI_KOKORO_VOICE=af_heart

# Only needed when GLYDI_SPEECH=hosted
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# --- brain ---
# local | claude | gemini | openai
#   local:  (default) an OpenAI-compatible server on this machine. Ollama out
#           of the box: brew install ollama && brew services start ollama &&
#           ollama pull qwen2.5:3b. Also llama-server, LM Studio, mlx_lm.server
#           via GLYDI_LOCAL_LLM_URL. ~0.8-1.2s turns on an 8 GB M2.
#   claude: best quality + lowest latency (fast mode). Needs API credits --
#           a Claude.ai subscription does NOT include API access.
#   gemini: has a free tier. Get a key at aistudio.google.com
#   openai: pay-as-you-go.
GLYDI_LLM=local

GLYDI_LOCAL_LLM_URL=http://localhost:11434/v1
# Must call tools reliably and must not have a thinking phase (dead air before
# every reply) and fit the GPU next to the speech and vision models. qwen2.5:3b
# does all three on an 8 GB Mac (20/20 tool calls, 70-130ms first token). See
# the README's model note before changing it; 7-8B models spill to CPU on 8 GB.
GLYDI_LOCAL_MODEL=qwen2.5:3b
# Background fact extraction uses the conversation model unless overridden.
# GLYDI_MEMORY_MODEL=qwen2.5:1.5b

# Only needed for the hosted brains
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
GLYDI_GEMINI_MODEL=gemini-3.8-flash
GLYDI_OPENAI_MODEL=gpt-4o

# --- claude-specific ---
GLYDI_MODEL=claude-opus-5
# Fast mode: up to 2.5x output tokens/sec on Opus 5 / 4.8.
# Costs $10/$50 per MTok instead of $5/$25. Set to 0 to trade latency back for cost.
GLYDI_FAST_MODE=1
GLYDI_EFFORT=low
GLYDI_MAX_TOKENS=300

# --- speech ---
GLYDI_DEEPGRAM_MODEL=nova-3
GLYDI_CARTESIA_MODEL=sonic-2
GLYDI_CARTESIA_VOICE=79a125e8-cd45-4c13-8a67-188112f4dd22

# --- identity ---
# Set to 0 to run conversation-only (useful for isolating latency when profiling).
GLYDI_IDENTITY=1
GLYDI_CAMERA_INDEX=0
GLYDI_FACE_MODEL=buffalo_s
GLYDI_VISION_FPS=8
# Open-set thresholds. Tune these on YOUR gallery, not on published benchmarks.
GLYDI_FACE_THRESHOLD=0.36
GLYDI_FACE_MARGIN=0.06
GLYDI_VOICE_THRESHOLD=0.55
GLYDI_VOICE_MARGIN=0.08

GLYDI_DB=data/people.db
